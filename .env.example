# DHDC KPI — ตัวอย่างการตั้งค่า environment
# คัดลอกเป็น .env.local แล้วใส่ค่าจริง (.env.local ถูก gitignore — ห้าม commit ค่าจริง)
# ถ้าไม่ตั้งค่าใดเลย ระบบจะ default เป็น local dev (dhdc_dev) อัตโนมัติ

# ── ฐานข้อมูล ──────────────────────────────────────────────
# local dev (ค่า default ถ้าไม่ตั้ง):
#   DB_HOST=127.0.0.1
#   DB_NAME=dhdc_dev
#   DB_USER=root
#   DB_PASSWORD=123456
# production (ตัวอย่าง — ใส่ค่าจริงใน .env.local เท่านั้น):
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ── ป้ายแสดง DB บนหน้าจอ (login/admin) ──────────────────────
# dev = "local dev" · production = "production"
NEXT_PUBLIC_DB_LABEL=local dev

# ── Auth-1: กุญแจลับเซ็น session JWT (HttpOnly cookie) ──────────
# production ต้องตั้งค่าสุ่มยาวๆ เช่น: openssl rand -base64 32
# dev ไม่ตั้งก็ได้ (ใช้ fallback ชั่วคราวใน lib/auth.ts — ไม่ปลอดภัย ห้ามใช้จริง)
AUTH_SECRET=

# ── MOPH auto-batch cron (ดูรายละเอียดใน lib/scheduler.ts) ──
# MOPH_CRON=0 7 * * *        # ทุกวัน 07:00
# MOPH_CRON_TZ=Asia/Bangkok
# MOPH_FETCH_PROVINCE=66
# MOPH_FETCH_AREACODE=6611   # อำเภอดงเจริญ
# MOPH_CRON_DISABLED=1       # 1 = ปิด cron (เช่น ใช้ Task Scheduler ภายนอกแทน)
